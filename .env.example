# === POLY_LIGHTER_1 ===
POLY_LIGHTER_PROFILE=POLY_LIGHTER_1
INSTANCE_NAME=POLY_LIGHTER_1

# mainnet only for this deploy (testnet not used)
LIGHTER_NETWORK=mainnet
LIGHTER_API_PRIVATE_KEY=
LIGHTER_ACCOUNT_INDEX=0
LIGHTER_API_KEY_INDEX=4
LIGHTER_L1_ADDRESS=

# MUST be a different Lighter account than donchian_trade (this bot uses 100% equity).
LIGHTER_SYMBOL=BTC
# POLY_LIGHTER_1 is locked to BTC, 1x and 100% equity; the app rejects deviations.
LIGHTER_LEVERAGE=1
LIGHTER_EQUITY_FRACTION=1.0
# IOC price guard: at most 5 bps away from the fresh reference price.
MARKET_SLIPPAGE=0.0005
EXIT_MARKET_SLIPPAGE=0.02
STOP_PRICE_PCT=0.00125

PM_SERIES_SLUG=btc-updown-5m
PM_THRESHOLD=0.65
PM_MAX_SPREAD=0.05
PM_PREWARM_SECONDS=15
ENTRY_MAX_LAG_SECONDS=2.0
EXIT_EARLY_SECONDS=0.30
SHADOW_BINANCE_1S=true

HALT_ON_EXIT_LATE_STREAK=3
HALT_DD_PCT=0.08

KILL_SWITCH=false
DRY_RUN=false

SQLITE_PATH=/data/bot.db
LOG_DIR=/data/logs
HTTP_ADDR=:8080
DASHBOARD_PASSWORD=change-me
COOKIE_SECURE=false

# Host port for this dashboard. Donchian already uses 80 — keep 8081 here.
WEB_PORT=8081

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
TELEGRAM_HEARTBEAT_MINUTES=60
